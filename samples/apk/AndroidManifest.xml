<?xml version="1.0" encoding="utf-8"?>
<!-- Sample APK for tests/test_apk.c: a NativeActivity app with no Java code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.henge.sample"
    android:versionCode="7"
    android:versionName="1.2.3">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <application android:label="henge sample" android:hasCode="false">
        <activity android:name="android.app.NativeActivity" android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="add" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
